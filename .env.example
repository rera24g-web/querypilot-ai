OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o
# Local default is SQLite. For Supabase use a READ-ONLY role:
# DATABASE_URL=postgresql+psycopg2://readonly_user:password@host:5432/postgres
DATABASE_URL=sqlite:///querypilot.db
MAX_ROWS=200
QUERY_TIMEOUT_MS=8000
ALLOWED_ORIGINS=http://localhost:3000   # on Render: your Vercel URL
APP_DATABASE_URL=sqlite:///querypilot_app.db   # saved investigations (writable; separate from the analytics DB)

# ============================================
# Supabase Auth Configuration (REQUIRED)
# ============================================
# Set these when deploying with Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase  # NOT the service role key!
SUPABASE_AUDIENCE=authenticated  # Default is 'authenticated'
